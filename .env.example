# Copy to .env and fill in. Every key the app reads is listed here.

DATABASE_URL="postgresql://daksh@localhost:5433/kids_store?schema=public"
APP_URL="http://localhost:3100"
NEXT_PUBLIC_STORE_NAME="Printora"

# Admin dashboard login (/admin)
ADMIN_PASSWORD="change-me"
# Signs login cookies. Any long random string.
SESSION_SECRET="replace-with-a-long-random-string"

# Razorpay Test Mode keys (Dashboard → Settings → API Keys, while in Test Mode).
# Leave both empty to use the built-in demo payment screen instead.
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
# Set when you add a webhook in the Razorpay dashboard (optional on localhost).
RAZORPAY_WEBHOOK_SECRET=""

# How long a purchase's download links work, and how many downloads each gets.
DOWNLOAD_EXPIRY_DAYS="30"
DOWNLOAD_LIMIT="5"

# Email. Leave SMTP_HOST empty and emails are saved to Admin → Emails instead of sent.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
EMAIL_FROM="Printora <hello@example.com>"

# Google Analytics 4 measurement ID, e.g. G-XXXXXXX (optional)
NEXT_PUBLIC_GA_ID=""
